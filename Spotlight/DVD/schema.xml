<?xml version="1.0" encoding="UTF-8"?>
 
<schema version="1.0" xmlns="http://www.apple.com/metadata"
                      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                      xsi:schemaLocation="http://www.apple.com/metadata file:///System/Library/Frameworks/CoreServices.framework/Frameworks/Metadata.framework/Resources/MetadataSchema.xsd">
    <attributes>
        <attribute name="com_discident_fingerprint" multivalued="false" type="CFString"/>
    </attributes>

    <types>
        <type name="public.dvdmedia">
            <note>The keys that this metadata importer handles.</note>
            <allattrs>com_discident_fingerprint</allattrs>
            <displayattrs>com_discident_fingerprint</displayattrs>
        </type>
    </types>
</schema>

